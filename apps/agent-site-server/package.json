{
  "name": "agent-site-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:content": "tsx src/build.ts",
    "build": "yarn build:content && tsx src/export-gh-pages.ts",
    "check": "tsx src/check.ts",
    "export:gh-pages": "yarn build:content && tsx src/export-gh-pages.ts",
    "publish:gh-pages": "bash ../../scripts/publish-gh-pages.sh",
    "build:server": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node build/server.js"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.0",
    "@fastify/rate-limit": "^8.0.0",
    "fastify": "^4.29.1",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "tiktoken": "^1.0.10"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  }
}
